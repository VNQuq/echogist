# Secrets — NEVER commit
.env
.env.*
!.env.example
.envrc
secrets/
*.key
*.pem
# EchoGist API key file — env ANTHROPIC_API_KEY always wins; this is the fallback.
# The committed .example template documents the format.
config/secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.uv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# EchoGist runtime artifacts (recovery state, not source)
output/
# Downloaded Whisper model (TD-1) — fetched/pre-placed, never committed
models/
# Model-fetch download cache + partial downloads
.cache/
*.part
# Operator's runtime settings — written by the Settings menu, not source
config/settings.json
# Picker state (TD-10) — last-used input dir, written by the app, not source
config/state.json
# Model display-name cache — local memory for scripts/check-models.py bump
# detection, written by that tool (derived state, machine-local, not source)
config/model_names.json
# Operator test clips — placed locally per tests/fixtures/audio/README.md, never committed
tests/fixtures/audio/*
!tests/fixtures/audio/README.md
# Operator scratch — real transcripts/recordings copied in for local inspection and
# calibration (e.g. reseeding the [scan] constants). Personal material, never committed.
temp/

# Data / logs / dumps
data/
logs/
*.log
*.dump
*.sql.gz
*.tar.gz
.scratch/

# Node
node_modules/
.next/

# Docker volumes
pg_data/
redis_data/

# Backup artefacts
*.bak
*.backup
_commit_msg.txt

# gstack — local-only artifacts
.gstack/
.claude/
.context/
~/.gstack/
.gstack-worktrees/