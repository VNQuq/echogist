# EchoGist runtime dependencies — SOURCE OF TRUTH (plan §2 / §12.2).
#
# The hash-pinned lockfile is generated from this file:
#     scripts/lock-deps   ->   requirements.lock
# run.bat installs with:  pip install --require-hashes -r requirements.lock
#
# Cross-platform: CUDA wheels are platform-specific (win_amd64 vs manylinux).
# scripts/lock-deps uses uv's universal resolver (one pass, no Windows box) to pin
# ONE version set and emit --hash lines covering both platform wheels; sys_platform
# markers carry the OS-only deps. Still confirm it installs on the first Windows
# cold run (plan §12.2).

faster-whisper==1.2.*
imageio-ffmpeg==0.6.*
fpdf2==2.*
anthropic>=0.109

# --- v1.1 menu/UX overhaul (plan §2): interactive console layer ------------------
# Both pure-Python, no native/ABI component — they do NOT touch the ctranslate2 <->
# cuDNN skew the GPU pins below guard. questionary pulls prompt_toolkit + wcwidth;
# rich was already resolved transitively (typer) and is now a first-class dep.
questionary==2.*
rich>=13

# --- The one pin that matters: cuDNN MAJOR <-> ctranslate2 build ------------------
# ctranslate2's GPU binary is built against a specific cuDNN MAJOR (4.4+ -> cuDNN 9).
# The nvidia-cudnn-cu12 / nvidia-cublas-cu12 wheel majors MUST match the ctranslate2
# build, or you get a silent cuDNN ABI mismatch -> cryptic DLL load error on first
# run (the #1 silent first-run failure, TD-3 / outside-voice #4).
#
# NEVER bump ctranslate2 with `pip install -U` on its own, and never bump cudnn/cublas
# independently. Bumping = re-run scripts/lock-deps, then a Windows cold run + the
# §12.3 GPU smoke BEFORE committing the new lock. This comment is the skew tripwire.
ctranslate2==4.8.*
nvidia-cudnn-cu12==9.*
nvidia-cublas-cu12==12.*
