# EchoGist dev/CI gate tools — SOURCE OF TRUTH for requirements-dev.lock.
#
# Generated by scripts/lock-deps together with requirements.lock, and resolved
# against it (-c) so a transitive pin both sides share never diverges. CI installs:
#     pip install --require-hashes -r requirements.lock -r requirements-dev.lock
# Pinned exactly: a ruff or mypy bump changes what the gate accepts, so it is a
# deliberate commit, never a side effect of a fresh install.
ruff==0.16.6
mypy==2.3.1
pytest==9.1.1
