#!/usr/bin/env bash
# EchoGist dev fast loop (plan §12.1 / T13).
#
# The fast inner loop runs in WSL with the real GPU: lint + types + the pure-stage
# test suite against the STUB summarizer (killswitch-safe — no live API, no key).
# Cold Windows runs are reserved for scripts/win-smoke.bat.
#
#   scripts/dev-loop          ruff + ruff format + mypy + pytest (the default fast loop)
#   scripts/dev-loop --gpu    ... then the optional real-GPU transcribe of a
#                             fixture clip (extract + transcribe in WSL; offline —
#                             the paid summary stays killswitch-gated). Needs a clip
#                             at tests/fixtures/audio/ (see the README there).
set -euo pipefail
cd "$(dirname "$0")/.."

GPU_SMOKE=0
if [ "${1:-}" = "--gpu" ]; then
  GPU_SMOKE=1
fi

VENV="${VENV:-.venv}"
# shellcheck disable=SC1091
source "$VENV/bin/activate"

# WSL/Linux only: ctranslate2 dlopens the nvidia cuBLAS/cuDNN .so files, and
# ld.so reads LD_LIBRARY_PATH only at process start — so any real-GPU transcribe
# launched from this shell needs the wheel lib dirs exported here (on Windows the
# win32 add_dll_directory shim in echogist/gpu.py handles this instead). Harmless
# for the pure-stage suite below, which imports no CUDA.
if command -v python >/dev/null 2>&1; then
  _SP="$(python -c 'import sysconfig;print(sysconfig.get_paths()["purelib"])' 2>/dev/null || true)"
  if [ -n "${_SP:-}" ] && [ -d "$_SP/nvidia" ]; then
    export LD_LIBRARY_PATH="$_SP/nvidia/cublas/lib:$_SP/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}"
  fi
fi

echo "== ruff =="
ruff check .
ruff format --check .

echo "== mypy =="
mypy

echo "== pytest =="
pytest

if [ "$GPU_SMOKE" -eq 1 ]; then
  echo "== gpu transcribe smoke (fixture) =="
  # Offline by default: ECHOGIST_LIVE_SMOKE is left unset, so smoke_run drives
  # extract + transcribe only and skips the paid summary. Reuses the one ship
  # driver so WSL and Windows exercise the same code path.
  python scripts/smoke_run.py
fi

echo "dev-loop: all gates green."
