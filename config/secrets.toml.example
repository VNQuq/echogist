# EchoGist secrets — COPY this file to `config/secrets.toml` and fill in your key.
#
#   secrets.toml is gitignored; this .example template is the only copy in git.
#   The ANTHROPIC_API_KEY environment variable, if set, ALWAYS wins over this file
#   (the file is the convenience fallback so you don't re-set the env each launch).
#
# Get a key at https://console.anthropic.com/ . Only the summarize step uses it;
# MP3 extraction and transcription run without one.

anthropic_api_key = "sk-ant-..."

# NOTE: the GitHub release token is NOT here — it is release tooling, not an app
# secret. `scripts/release.py` reads it from the repo-specific env var
# ECHOGIST_GITHUB_TOKEN (set it in ~/.bashrc). See that script's docstring.
